rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity Health Check
    match /test/connection {
      allow read: if true;
    }

    // ─── HELPERS ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ─── ENTITY VALIDATIONS ───────────────────────────────────────
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 256
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid
        && data.text is string && data.text.size() <= 5000
        && data.timestamp is number
        && data.roomId is string && data.roomId.size() <= 64;
    }

    // ─── COLLECTIONS ──────────────────────────────────────────────

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // Chat Messages
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn(); // In a real app, check room membership
      allow create: if isSignedIn() && isValidMessage(incoming());
      // Messages are immutable in this simple version
      allow delete: if isSignedIn() && existing().senderId == request.auth.uid;
    }
  }
}